rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function esAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == "admin";
    }
    function esRol(rol) {
      return request.auth != null &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == rol;
    }

    // 🆕 ¿El estudiante autenticado pertenece a esta universidad?
    // La usa `reclamos_cupos` (ver/tomar los cupos que reservó SU universidad).
    // El `exists()` es obligatorio: sin él, un usuario con rol 'estudiante' que
    // aún no tenga doc en perfiles_estudiantes haría fallar la evaluación de la
    // regla completa. Mismo patrón defensivo que `esEstudianteDelGrupo()`.
    function esEstudianteDe(uniId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/perfiles_estudiantes/$(request.auth.uid))
        && get(/databases/$(database)/documents/perfiles_estudiantes/$(request.auth.uid)).data.universidad_id == uniId;
    }

    // 🛡️ PANEL ADMIN — colecciones internas (solo admin)
    match /audit_logs/{logId} {
      allow read, create: if esAdmin();
      allow update, delete: if false;
    }
    match /admin_notifications/{notifId} {
      allow read, update, delete: if esAdmin();
      // `crearReporte()` (reporteService.ts) genera una de estas al reportar
      // usuario/contenido — el emisor nunca es admin, así que create no puede
      // exigirlo o el reporte jamás notifica (bug real, detectado en auditoría).
      allow create: if request.auth != null;
    }
    match /permissions/{permId} {
      allow read, write: if esAdmin();
    }
    match /role_permissions/{docId} {
      allow read, write: if esAdmin();
    }

    // OTP — bloqueado a clientes (solo Cloud Functions vía Admin SDK).
    // 🔒 CAMBIO: cubrimos ambos nombres (consola usa codigos_login, repo codigos_otp).
    match /codigos_login/{email} { allow read, write: if false; }
    match /codigos_otp/{email}   { allow read, write: if false; }

    // 🟢 PRESENCIA (punto verde del chat)
    // Colección SOLO para presencia: { uid, status: 'online'|'offline', lastSeen,
    // activeChatId }. Se separó de `usuarios` para poder darle lectura pública
    // (a autenticados) SIN exponer el correo ni el resto del perfil. Cada usuario
    // escribe únicamente su propio doc (heartbeat en AuthContext + activeChatId
    // en ChatThread). La lee ChatThread (peer) y la Cloud Function notifNuevoMensaje.
    match /presencia/{uid} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // 👥 USUARIOS  (perfil base — la presencia YA NO vive aquí)
    // 🔒 CAMBIO: se consolidó en UN solo bloque y se restringió la lectura. Antes
    //    había un `allow read: if request.auth != null` que exponía el `correo`
    //    de todos. Ahora solo el dueño, empresa/universidad (que revisan perfiles)
    //    o admin pueden leer. Un estudiante ya NO lee el doc de otro estudiante.
    match /usuarios/{userId} {
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        esRol('empresa') || esRol('universidad') || esAdmin()
      );
      allow create: if request.auth != null;
      // 🔒 CAMBIO: rol/status/activo/baneado/motivo_baneo/approval_status ya no
      // se pueden escribir directo desde el cliente (ni el propio dueño ni un
      // admin) — solo las Cloud Functions de functions/src/admin.ts (Admin SDK,
      // bypassan estas reglas) los tocan. Cierra el hueco de que alguien se
      // autopromueva a admin o se desbanee escribiendo directo a Firestore.
      allow update: if (request.auth.uid == userId || esAdmin())
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['rol', 'status', 'activo', 'baneado', 'motivo_baneo', 'approval_status']);
      allow delete: if esAdmin();
    }

    // 🎓 PERFILES_ESTUDIANTES
    match /perfiles_estudiantes/{studentId} {
      // 🔒 'universidad' solo lee a SU alumno; 'empresa' abierto (firmarAcuerdo lee
      //    alumnos del grupo). Cierre pendiente: denormalizar `empresas_autorizadas`.
      allow read: if request.auth.uid == studentId
                     || resource.data.universidad_id == request.auth.uid
                     || esRol('empresa')
                     || esAdmin();
      allow create: if esRol('universidad') || esAdmin();
      // 🆕 CAMBIO: además del dueño / universidad dueña / admin, una EMPRESA puede
      //    actualizar el perfil SOLO en los campos de gamificación/calificación
      //    (feedbackService.enviarFeedback y ProfileViewerModal escriben el rango,
      //    XP y promedio del estudiante evaluado). El `hasOnly` impide que la
      //    empresa toque cualquier otro campo.
      allow update: if request.auth.uid == studentId
                     || resource.data.universidad_id == request.auth.uid
                     || esAdmin()
                     || (esRol('empresa')
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly([
                                'puntos_experiencia', 'pasantias_completadas',
                                'calificaciones_recibidas', 'calificacion_promedio',
                                'rango_nivel', 'rango_tier', 'estado_pasantia',
                              ]));
      allow delete: if esAdmin();

      // ⭐ Reseñas de empresa → estudiante (ProfileViewerModal: subcolección
      //    `calificaciones`). Sin esta regla las reseñas y su lectura se denegaban
      //    (las subcolecciones NO heredan la regla del padre).
      match /calificaciones/{calId} {
        allow read: if request.auth != null;
        allow create: if esRol('empresa')
          && request.resource.data.empresa_id == request.auth.uid;
        allow update, delete: if esAdmin();
      }
    }

    // ⭐ EVALUACIONES_ESTUDIANTES
    // 🔒 lectura solo partes/admin; create/update exige ser la empresa dueña.
    match /evaluaciones_estudiantes/{evalId} {
      allow read: if request.auth != null && (
        resource.data.estudiante_id == request.auth.uid ||
        resource.data.empresa_id == request.auth.uid ||
        esAdmin()
      );
      allow create, update: if esRol('empresa')
        && request.resource.data.empresa_id == request.auth.uid;
    }

    // 🏢 PERFILES_EMPRESAS (perfil público para usuarios registrados)
    match /perfiles_empresas/{empresaId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == empresaId || esAdmin();
      // 🆕 CAMBIO: además del dueño / admin, un ESTUDIANTE puede actualizar el
      //    perfil de la empresa SOLO en los campos de gamificación (feedback
      //    estudiante → empresa escribe XP/rango/promedio de la empresa evaluada).
      //    Y una UNIVERSIDAD puede sumar SU propio id a `aliados_universidades_ids`
      //    (arrayUnion, dedupe automático) al aprobar una pasantía de grupo —
      //    alimenta "Top Empresas/Universidades" (RedGradlyBanner) sin depender de
      //    leer `solicitudes_practicas` desde cualquier sesión (esa colección solo
      //    la puede leer cada dueño — ver el bloque de abajo).
      allow update: if request.auth.uid == empresaId
                     || esAdmin()
                     || (esRol('estudiante')
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly([
                                'puntos_experiencia', 'pasantias_completadas',
                                'calificaciones_recibidas', 'calificacion_promedio',
                                'rango_nivel', 'rango_tier',
                              ]))
                     || (esRol('universidad')
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['aliados_universidades_ids']));
      allow delete: if esAdmin();
    }

    // 🏫 PERFILES_UNIVERSIDADES
    match /perfiles_universidades/{uniId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == uniId || esAdmin();
      // 🆕 CAMBIO: espejo del bloque de arriba — una EMPRESA puede sumar su
      //    propio id a `aliados_empresas_ids` al aprobar una pasantía de grupo.
      allow update: if request.auth.uid == uniId
                     || esAdmin()
                     || (esRol('empresa')
                         && request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['aliados_empresas_ids']));
      allow delete: if esAdmin();
    }

    // 📚 CATÁLOGO / CONFIG GLOBAL (carreras con estado_soporte, etc.)
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if esAdmin();
    }

    // 💼 VACANTES
    match /vacantes/{vacanteId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.empresa_id == request.auth.uid;
      allow delete: if request.auth != null && resource.data.empresa_id == request.auth.uid;

      // 🆕 CAMBIO CRÍTICO (reparto de cupos): antes el update era EXCLUSIVO de la
      //    empresa dueña, así que `reclamarCupos` (universidad) y `tomarCupo`
      //    (estudiante) fallaban con permission-denied — ambos escriben el
      //    contador `cupos_reclamados` de la vacante.
      //    Ahora la empresa dueña puede todo; universidad y estudiante SOLO
      //    pueden mover ese contador. El `hasOnly` impide que de paso alteren
      //    título, cupos totales, horario o cualquier otro campo.
      //    `aplicantes_count` se agregó aparte: `aplicarAVacante` (estudiante)
      //    lo incrementa al postularse a una vacante individual y esa escritura
      //    quedaba fuera de este `hasOnly`, así que fallaba con permission-denied
      //    aunque la aplicación en sí ya se hubiera creado (bug real, detectado
      //    al construir el flujo de autoservicio a pasantías).
      allow update: if request.auth != null && (
        resource.data.empresa_id == request.auth.uid
        || (
          (esRol('universidad') || esRol('estudiante'))
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['cupos_reclamados', 'aplicantes_count'])
        )
      );
    }

    // 🎟️ RECLAMOS DE CUPOS (la universidad reserva N plazas de una vacante)
    // 🆕 Colección nueva del reparto por lote. Los cupos se reservan al reclamar
    //    (aunque queden pendientes de confirmación), para que dos universidades
    //    no puedan pedir las mismas plazas mientras la empresa decide.
    match /reclamos_cupos/{reclamoId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.universidadId
            || request.auth.uid == resource.data.empresaId
            // El estudiante ve el tablero de cupos que reservó SU universidad.
            || esEstudianteDe(resource.data.universidadId)
            || esAdmin());

      // Solo la universidad dueña crea. `estado` acotado para que no pueda
      // auto-confirmarse un reclamo que la empresa dejó en modo manual
      // (el estado real lo decide el servicio según `vacantes.reclamos_auto`).
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.universidadId
        && request.resource.data.estado in ['pendiente', 'aceptado'];

      allow update: if request.auth != null && (
        // Empresa responde (acepta/rechaza); universidad libera cupos.
        (
          (request.auth.uid == resource.data.empresaId
            || request.auth.uid == resource.data.universidadId
            || esAdmin())
          && request.resource.data.universidadId == resource.data.universidadId
          && request.resource.data.empresaId == resource.data.empresaId
        )
        // El estudiante SOLO mueve el contador `tomados` (al elegir o cancelar
        // su cupo); no puede tocar cantidad, estado ni el plazo.
        || (
          esEstudianteDe(resource.data.universidadId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tomados'])
        )
      );
      allow delete: if esAdmin();
    }

    // 🪑 ASIGNACIONES DE CUPO (el estudiante tomó una de las plazas del lote)
    // 🆕 Colección nueva. Un doc por estudiante que eligió empresa desde su
    //    tablero. `cancelarCupo` la marca 'cancelado' y devuelve el cupo al lote.
    match /asignaciones_cupo/{asignacionId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.estudianteId
            || request.auth.uid == resource.data.universidadId
            || request.auth.uid == resource.data.empresaId
            || esAdmin());
      // Solo el propio estudiante toma su cupo, y nace siempre 'tomado'.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.estudianteId
        && request.resource.data.estado == 'tomado';
      // Cancelar: el dueño o su universidad. Nunca se reasigna a otro alumno.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.estudianteId
            || request.auth.uid == resource.data.universidadId
            || esAdmin())
        && request.resource.data.estudianteId == resource.data.estudianteId;
      allow delete: if esAdmin();
    }

    // 🤝 APLICACIONES_GRUPOS (Universidad → Vacante)
    match /aplicaciones_grupos/{aplicacionId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.universidadId
            || request.auth.uid == resource.data.empresaId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.universidadId
        && request.resource.data.estado == 'pendiente';
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.empresaId
            || request.auth.uid == resource.data.universidadId)
        && request.resource.data.universidadId == resource.data.universidadId
        && request.resource.data.empresaId == resource.data.empresaId;
      allow delete: if false;
    }

    // 📝 APLICACIONES
    match /aplicaciones/{aplicacionId} {
      allow read: if resource.data.estudiante_id == request.auth.uid ||
                     resource.data.empresa_id == request.auth.uid ||
                     resource.data.universidad_id == request.auth.uid ||
                     esAdmin();
      allow create: if esRol('estudiante');
      allow update: if resource.data.empresa_id == request.auth.uid ||
                       resource.data.universidad_id == request.auth.uid ||
                       esAdmin();
      allow delete: if esAdmin();
    }

    // 💳 TRANSACCIONES
    match /transacciones/{transaccionId} {
      allow read: if request.auth != null && (
        resource.data.empresa_id == request.auth.uid ||
        resource.data.estudiante_id == request.auth.uid ||
        resource.data.creado_por == request.auth.uid ||
        esAdmin()
      );
      allow create: if request.auth != null
        && request.resource.data.creado_por == request.auth.uid;
      allow update: if resource.data.empresa_id == request.auth.uid || esAdmin();
      allow delete: if esAdmin();
    }

    // 🚩 REPORTES
    match /reportes/{reporteId} {
      allow read: if resource.data.reportador_id == request.auth.uid || esAdmin();
      allow create: if request.auth != null;
      // 🔒 CAMBIO: estado/resolucion ya no se escriben directo desde el cliente
      // — solo resolveReport (Cloud Function, admin.ts) los toca, para dejar
      // auditoría server-side en audit_logs.
      allow update: if esAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['estado', 'resolucion']);
      allow delete: if esAdmin();
    }

    // 🔔 NOTIFICACIONES
    match /notificaciones_app/{notificacionId} {
      allow read, update, delete: if resource.data.destinatario_id == request.auth.uid || esAdmin();
      allow create: if request.auth != null;
    }
    match /notificaciones_estudiantes/{notifId} {
      allow read, update, delete: if request.auth != null &&
        (resource.data.estudianteId == request.auth.uid || esAdmin());
      allow create: if request.auth != null;
    }

    // ⚙️ UNIVERSIDADES_CONFIG
    match /universidades_config/{configId} {
      allow read: if request.auth != null;
      allow write: if esRol('universidad') || esAdmin();
    }

    // 📚 GRUPOS
    match /grupos/{grupoId} {
      allow read: if request.auth != null;
      allow create: if esRol('universidad') || esAdmin();

      // 🆕 CAMBIO (fix doble compromiso de grupo): `pasantia_activa_id` es un
      //    flag denormalizado que marca si el grupo ya tiene una pasantía
      //    aprobada — lo fijan `firmarAcuerdo`/`respuestaFinalUniversidad` y lo
      //    libera `finalizarPasantia`. La EMPRESA necesita poder escribirlo
      //    cuando es ella quien firma el acuerdo en el chat (grupos/{id} es de
      //    lectura abierta, pero su `update` era exclusivo de la universidad
      //    dueña). El `hasOnly` es el mismo patrón que ya usa `vacantes` con
      //    `cupos_reclamados`: impide que de paso altere nombre, carrera,
      //    docente o cualquier otro campo del grupo.
      allow update: if request.auth != null && (
        resource.data.universidad_id == request.auth.uid || esAdmin()
        || (
          esRol('empresa')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pasantia_activa_id'])
        )
      );
      allow delete: if resource.data.universidad_id == request.auth.uid || esAdmin();
    }

    // 🤝 SOLICITUDES_PRACTICAS (corazón de la pasantía)
    match /solicitudes_practicas/{solicitudId} {
      // 🆕 CAMBIO: el ESTUDIANTE puede leer las solicitudes de SU grupo. Necesario
      //    para "feedback pendiente" (feedbackService.getFeedbackPendiente →
      //    query solicitudes_practicas where grupoId == miGrupo). Sin esto la query
      //    del estudiante se rechazaba con "Missing or insufficient permissions".
      //    Se verifica su grupo vía perfiles_estudiantes/{uid}.grupo_id.
      function esEstudianteDelGrupo() {
        return request.auth != null
          && 'grupoId' in resource.data
          && exists(/databases/$(database)/documents/perfiles_estudiantes/$(request.auth.uid))
          && get(/databases/$(database)/documents/perfiles_estudiantes/$(request.auth.uid)).data.grupo_id == resource.data.grupoId;
      }

      allow read: if request.auth != null && (
        resource.data.universidadId == request.auth.uid ||
        resource.data.empresaId == request.auth.uid ||
        (resource.data.keys().hasAll(['estudianteIds'])
           && request.auth.uid in resource.data.estudianteIds) ||
        esEstudianteDelGrupo() ||
        esAdmin()
      );
      allow create: if request.auth != null && (
        (esRol('universidad') && request.resource.data.universidadId == request.auth.uid) ||
        request.resource.data.empresaId == request.auth.uid
      );
      allow update: if request.auth != null && (
        resource.data.universidadId == request.auth.uid ||
        resource.data.empresaId == request.auth.uid ||
        esAdmin()
      );
      allow delete: if request.auth != null && (resource.data.universidadId == request.auth.uid || esAdmin());
    }

    // 💬 CHATS Y MENSAJERÍA
    match /chats/{chatId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.users;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.users;
      allow update: if request.auth != null && (
        request.auth.uid in resource.data.users ||
        (resource.data.keys().hasAll(['admins']) && request.auth.uid in resource.data.admins)
      );
      allow delete: if esAdmin();

      match /messages/{messageId} {
        allow read, create: if request.auth != null &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow update: if request.auth != null && (
            resource.data.user._id == request.auth.uid ||
            (('admins' in get(/databases/$(database)/documents/chats/$(chatId)).data)
               && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.admins) ||
            esAdmin()
          );
        allow delete: if esAdmin();
      }
    }

    // 🤝 SOLICITUDES LEGADO — ⚠️ lectura abierta a cualquier autenticado.
    // Si ya no se usan (no hallé escrituras activas), ELIMINA estos tres bloques.
    match /solicitudes_grupos/{solicitudId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if esAdmin() || resource.data.empresa_id == request.auth.uid;
    }
    match /solicitudes_empresas/{solicitudId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if esAdmin() || resource.data.empresa_id == request.auth.uid;
    }
    match /solicitudes/{solicitudId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if esAdmin() || resource.data.empresa_id == request.auth.uid;
    }

    // 📈 FEEDBACK_PASANTIAS (evaluación mutua estudiante ↔ empresa, escala 1–10)
    // 🔒 CAMBIO CRÍTICO: los nombres de campo de la regla estaban equivocados
    //    (`estudiante_id`/`empresa_id`/`remitente_id`). El código escribe
    //    `evaluadorId`/`evaluadoId` (ver feedbackService.enviarFeedback y la query
    //    getFeedbackPendiente `where evaluadorId == uid`). Con los nombres viejos
    //    TODO read/create se denegaba → "Error detectando feedback pendiente".
    match /feedback_pasantias/{feedbackId} {
      // Reseñas públicas a propósito: la bandeja de calificación+comentarios
      // de un perfil (ResenasFeedback.tsx) la puede ver cualquier usuario que
      // visite ese perfil, no solo quien calificó o fue calificado.
      allow read: if request.auth != null;
      // El emisor se registra a sí mismo como evaluador. Inmutable tras crearse.
      allow create: if request.auth != null
        && request.resource.data.evaluadorId == request.auth.uid;
      allow update: if false;
      allow delete: if esAdmin();
    }
  }
}
