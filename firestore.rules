rules_version = '2';

// ⚠️ SNIPPET DE REFERENCIA — NO es el ruleset completo del proyecto.
// Las reglas de Gradly se administran en la consola de Firebase. Copia y
// MERGEA los bloques `chats` y `notificaciones_estudiantes` de abajo dentro
// de tu `match /databases/{database}/documents { ... }` existente. Desplegar
// este archivo tal cual bloquearía el resto de colecciones.

service cloud.firestore {
  match /databases/{database}/documents {

    // ── CHATS Universidad ↔ Empresa (↔ Estudiante) y GRUPOS oficiales ──
    // Cualquier participante listado en `users` puede leer y escribir.
    // Esto cubre al rol estudiante automáticamente si su uid se agrega al
    // array `users` del chat tras aprobarse la pasantía o al crear el grupo.
    match /chats/{chatId} {
      // ¿El usuario es admin del grupo (universidad)?
      function esAdminChat() {
        return request.auth.uid in resource.data.admins;
      }

      allow read: if request.auth != null
        && request.auth.uid in resource.data.users;

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.users;

      // update: el remitente debe seguir siendo participante del chat.
      // (Cambiar `name`, `settings.adminsOnly` o `users`/expulsar lo hace la
      //  universidad, que es admin y participante a la vez.)
      allow update: if request.auth != null
        && request.auth.uid in resource.data.users;

      // Subcolección de mensajes: solo participantes del chat padre.
      match /messages/{messageId} {
        function chatData() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        allow read, create: if request.auth != null
          && request.auth.uid in chatData().users;

        // update: solo el autor (editar / borrado lógico propio) o un admin
        // del grupo (moderación: borrado lógico de mensajes ajenos).
        allow update: if request.auth != null
          && request.auth.uid in chatData().users
          && (
            request.auth.uid == resource.data.user._id
            || ('admins' in chatData() && request.auth.uid in chatData().admins)
          );
      }
    }

    // ── FEEDBACK de pasantías (evaluación bidireccional + subida de rango) ──
    // Cada parte crea su evaluación (evaluadorId == uid). La actualización del
    // rango del evaluado (perfiles_estudiantes/empresas) sigue el mismo patrón
    // ya usado por las calificaciones existentes (escritura desde el evaluador).
    match /feedback_pasantias/{feedbackId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.evaluadorId
            || request.auth.uid == resource.data.evaluadoId);
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.evaluadorId;
      // El feedback es inmutable una vez enviado.
      allow update, delete: if false;
    }

    // ── NOTIFICACIONES de acuerdo aprobado para estudiantes ──
    // El estudiante lee/actualiza (marcar leída) solo las suyas; las crea la
    // empresa al firmar el acuerdo (cualquier usuario autenticado puede crear).
    match /notificaciones_estudiantes/{notiId} {
      allow read, update: if request.auth != null
        && request.auth.uid == resource.data.estudianteId;
      allow create: if request.auth != null;
    }

    // ── NOTIFICACIONES in-app globales (campanita) ──
    // Las crea cualquier usuario autenticado desde los flujos de negocio
    // (notificationService.enviarNotificacion). El destinatario lee y marca
    // como leída solo las suyas.
    match /notificaciones_app/{notiId} {
      allow read, update: if request.auth != null
        && request.auth.uid == resource.data.destinatario_id;
      allow create: if request.auth != null;
    }

    // ── POSTULACIONES DE GRUPO  Universidad → Empresa ──
    // La universidad postula uno de sus grupos a una vacante (estado
    // 'pendiente'). Tanto la universidad dueña (universidadId) como la empresa
    // destino (empresaId) pueden leer. La empresa evalúa (→ 'revisando' /
    // 'rechazada') y la universidad da la respuesta final (→ 'aprobada' /
    // 'rechazada'), por lo que AMBAS pueden actualizar. Nadie borra.
    //
    // ⚠️ IMPORTANTE: los campos son camelCase (universidadId, empresaId,
    // vacanteId, grupoId), coincidiendo con el cliente
    // (pasantiaService.postularGrupoAVacante y Matchmaking). NO usar snake_case
    // aquí o la creación/lectura fallará con error de permisos.
    match /aplicaciones_grupos/{aplicacionId} {
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.universidadId
            || request.auth.uid == resource.data.empresaId);

      // Solo la universidad crea la postulación, y siempre en estado 'pendiente'.
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.universidadId
        && request.resource.data.estado == 'pendiente';

      // Empresa (evalúa) o universidad (respuesta final) pueden actualizar,
      // sin poder reasignar la titularidad de la postulación.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.empresaId
            || request.auth.uid == resource.data.universidadId)
        && request.resource.data.universidadId == resource.data.universidadId
        && request.resource.data.empresaId == resource.data.empresaId;

      allow delete: if false;
    }
  }
}
