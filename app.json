{
  "expo": {
    "name": "Gradly",
    "slug": "Gradly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gradly",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.gradly.app",
      "config": {
        "googleMapsApiKey": "AIzaSyCrsDxPdnVe_Xv9JrHs8j-gFqKugiEc6mc"
      }
    },
    "android": {
      "package": "com.gradly.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCrsDxPdnVe_Xv9JrHs8j-gFqKugiEc6mc"
        }
      },
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "gradly-e1a2a.firebaseapp.com",
              "pathPrefix": "/__/auth/links"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Gradly usa tu ubicación para marcar el lugar de trabajo de una vacante.",
          "locationWhenInUsePermission": "Gradly usa tu ubicación para marcar el lugar de trabajo de una vacante.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gradly necesita acceso a tu galería para subir imágenes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-localization",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3428312c-a058-4097-af44-ec5f7d7f2395"
      }
    },
    "owner": "djlo365s-team"
  }
}
